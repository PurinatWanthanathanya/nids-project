# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly ensure LF for Linux scripts and configs
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pcap binary
*.db binary

